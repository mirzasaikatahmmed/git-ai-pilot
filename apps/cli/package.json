{
  "name": "git-ai-pilot",
  "version": "1.2.11",
  "description": "Automated Git workflow with Gemini-generated commit messages",
  "main": "dist/index.js",
  "bin": {
    "git-auto": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "postinstall": "node scripts/postinstall.js",
    "version": "node scripts/update-changelog.js && git add CHANGELOG.md",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "git",
    "git-automation",
    "git-commit",
    "ai",
    "ai-commit",
    "gemini",
    "openai",
    "cli",
    "commit-message",
    "secret-scanner",
    "security-scan",
    "devtools",
    "developer-tools",
    "automation",
    "productivity"
  ],
  "author": {
    "name": "MIRZA SAIKAT AHMMED",
    "email": "contact@saikat.com.bd",
    "url": "https://github.com/mirzasaikatahmmed"
  },
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "inquirer": "^9.2.12",
    "openai": "^6.10.0",
    "ora": "^9.0.0",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
